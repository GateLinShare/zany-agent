# 复制为 .env 后按需填写。密钥类值一律不入库(.env 已 gitignore)。

# 模型接入(必填)
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 上下文: 模型窗口上限(状态栏分母) / 自动压缩触发阈值
ANTHROPIC_CONTEXT_TOKENS=128000
COMPACT_TRIGGER_RATIO=0.8

# 单次 run 的工具轮数上限(防模型打转烧钱), 超过后本轮中止
MAX_TURNS=120

# goal 回合预算(/goal 模式宿主自动续跑的轮数上限), 耗尽转 paused 可 /goal resume
GOAL_MAX_TURNS=500

# 是否显示思考内容(thinking): 1 显示 / 0 不显示(默认, 定稿和流式都不显示)
SHOW_THINKING=0

# 个人记忆文件路径(不设 = 默认 ~/.zany/USER.md); 服务器多人共用时各自
# export ZANY_USER_MEMORY=/自己的路径/USER.md, 防记忆互串
#ZANY_USER_MEMORY=

# 常驻风格包(styles/<name>.md, 逗号分隔; 空 = 不启用; 插拔: styles/ 加删 md 文件)
PROMPT_PACKS=

# MCP stdio 子进程 stderr 是否透传(1=透传, 默认收 devnull)
#MCP_STDERR=
