ANTHROPIC_BASE_URL=http://192.168.30.98:8000
ANTHROPIC_API_KEY=***REMOVED***
ANTHROPIC_MODEL=glm5.3

# 上下文: 模型窗口上限(状态栏分母) / 自动压缩触发阈值
ANTHROPIC_CONTEXT_TOKENS=128000
COMPACT_TRIGGER_RATIO=0.6

# 单次 run 的工具轮数上限(防模型打转烧钱), 超过后本轮中止
MAX_TURNS=120

# agent 名字(正文前缀显示)
AGENT_NAME=agent

# 用户消息前缀
USER_NAME=user

# 是否显示思考内容(thinking): 1 显示 / 0 不显示(默认, 定稿和流式都不显示)
SHOW_THINKING=0
